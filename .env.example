# --- Application ---
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# --- OpenRouter (LLM) ---
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Hugging Face (optional, for higher rate limits on model downloads) ---
# Get your token at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your-token-here

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- LLM ---
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# --- Qdrant Vector Database ---
# Use ":memory:" for in-memory mode (no server needed, data lost on restart)
# Use "http://localhost:6333" for a local Qdrant server (persistent storage)
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=luma_documents

# --- Retrieval ---
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
